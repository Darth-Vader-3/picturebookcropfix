rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAuthEmail(email) {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == email.lower();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'yamauchiryoko16@gmail.com',
          'admin@digipicture.org',
          'terrysalee1@gmail.com'
        ] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /picturebooks/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /users/{userId}/files/{fileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pending_registrations/{email} {
      allow read, write: if isAuthEmail(email) || isAdmin();
    }

    match /artist_applications/{docId} {
      allow read, write: if isSignedIn();
    }

    match /applications/{docId} {
      allow read, write: if isSignedIn();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.reviewerEmail == request.auth.token.email);
    }

    match /subscribers/{subId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    match /direct_messages/{msgId} {
      allow read: if isSignedIn() && (
        resource.data.senderEmail == request.auth.token.email || 
        resource.data.recipientEmail == request.auth.token.email ||
        resource.data.artistEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if true;
      allow delete: if isAdmin();
    }

    match /messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow delete: if isAdmin();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /feedback_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /ota_manifests/{manifestId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}

