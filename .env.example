# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Configured via Settings / Secrets panel in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SYSTEM_CRYPTO_SECRET: Secret key used for signing session HMAC-SHA256 tokens and client AES-GCM encryption.
VITE_SYSTEM_CRYPTO_SECRET="digipicture-secure-vault-key-2026-prod-secret"

# ADMIN_EMAIL & ADMIN_PASSWORD_HASH: System Administrator bootstrap credentials.
VITE_ADMIN_EMAIL="yamauchiryoko16@gmail.com"
VITE_ADMIN_PASSWORD_HASH="$pbkdf2$v1$10000$ecefb0e5834ee971ed59e0bb2156891a$88ed978d97955e06802c5ca8f7fe0ebbce5261ff42c5360c554cebf44cbc4bcc"

# SENTRY_DSN / ERROR_MONITORING_DSN: Sentry or compatible error monitoring DSN URL for production tracking.
VITE_SENTRY_DSN=""
VITE_ERROR_MONITORING_DSN=""

# APP_ENV: Deployment environment ('production' | 'beta' | 'staging' | 'development').
VITE_APP_ENV="beta"

# APP_VERSION: Semantic application version.
VITE_APP_VERSION="1.2.0"

# BUILD_CHANNEL: Distribution track ('beta_internal', 'testflight', 'play_testing', 'production_live').
VITE_BUILD_CHANNEL="beta_internal"

# OTA_MANIFEST_URL: (Optional) Remote endpoint URL for Over-The-Air hotfix updates.
VITE_OTA_MANIFEST_URL=""

